# Copy this file to .env and fill in your values.

# 1) Create a bot: message @BotFather on Telegram → /newbot → follow prompts → copy the token.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_TRENDS_CHAT_ID=
# 2) Get your chat id:
#    - Start a chat with your bot and send any message.
#    - Open: https://api.telegram.org/bot<TOKEN>/getUpdates
#    - Find "chat":{"id": ...} in the JSON. Paste that number here.
TELEGRAM_CHAT_ID=123456789

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# IT Trend Radar (main_trends.py) — delivers hot IT products to a SEPARATE
# Telegram chat. Both fall back to the job-radar bot/chat above if omitted.
# ----------------------------------------------------------------------------
# TELEGRAM_TRENDS_BOT_TOKEN=   # optional — reuse the main bot if blank
# TELEGRAM_TRENDS_CHAT_ID=     # required for the trends flow unless you want
                               # trends sent to the same chat as job alerts.
